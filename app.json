{
  "expo": {
    "name": "packed-mobile",
    "slug": "packed-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "packed-mobile",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trypacked.mobile",
      "buildNumber": "4"
    },
    "android": {
      "package": "com.trypacked.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#FBF7F2"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F2"
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "web": {
      "favicon": "./assets/images/favicon.svg"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
