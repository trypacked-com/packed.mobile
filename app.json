{
  "expo": {
    "name": "packed-mobile",
    "slug": "packed-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "packed-mobile",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icons/AppIcon-ui-lib.icon",
      "bundleIdentifier": "com.joshbatley.packedui",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
   "android": {
      "package": "com.joshbatley.packedui",
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F2",
        "foregroundImage": "./assets/icons/icon-android-foreground.png",
        "monochromeImage": "./assets/icons/icon-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F2"
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
